{
  "name": "htmx-crud",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel dev:server dev:css",
    "dev:server": "bun --hot src/index.ts",
    "dev:css": "bun x @tailwindcss/cli -i ./src/styles/app.css -o ./public/css/app.css --watch=always",
    "build:css": "bun x @tailwindcss/cli -i ./src/styles/app.css -o ./public/css/app.css --minify",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.29",
    "@elysia/cors": "^1.4.2",
    "@elysia/html": "^1.4.1",
    "@elysia/openapi": "^1.4.15",
    "@elysia/static": "^1.4.11",
    "@kitajs/html": "^4.2.13",
    "better-auth": "^1.6.29",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "htmx.org": "4.0.0-beta6",
    "postgres": "^3.4.9"
  }
}
